# Backend API Base URL (leave empty if using Vite proxy in local dev)
# Example: https://odooparty-backend.onrender.com/api
VITE_API_URL=/api

# WebSocket Server URL (leave empty or set to backend host)
# Example: https://odooparty-backend.onrender.com
VITE_SOCKET_URL=

# Backend target for Vite local dev proxy
VITE_BACKEND_URL=http://localhost:5000

# Google OAuth Client ID (optional, for real Google Sign-In)
VITE_GOOGLE_CLIENT_ID=
